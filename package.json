{
  "name": "@tetrac/login-sdk",
  "version": "0.6.0",
  "description": "Reusable, non-custodial authentication SDK: email/passkey, Web3 wallet, and biometric (WebAuthn PRF) login with client-side wallet generation. Bring your own database — PostgreSQL/Supabase, MySQL, SQLite, or Redis/Upstash.",
  "license": "MIT",
  "homepage": "https://github.com/tetrac-official/tetrac-login-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetrac-official/tetrac-login-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tetrac-official/tetrac-login-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./ledger": {
      "types": "./dist/ledger/index.d.ts",
      "import": "./dist/ledger/index.js",
      "require": "./dist/ledger/index.cjs"
    },
    "./storage/conformance": {
      "types": "./dist/storage/conformance.d.ts",
      "import": "./dist/storage/conformance.js",
      "require": "./dist/storage/conformance.cjs"
    },
    "./storage/sql": {
      "types": "./dist/storage/sql/index.d.ts",
      "import": "./dist/storage/sql/index.js",
      "require": "./dist/storage/sql/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "smoke:biometric": "npm run build && node scripts/smoke-biometric.mjs",
    "smoke:multiapp": "npm run build && node scripts/smoke-multi-app.mjs",
    "prepublishOnly": "npm run build",
    "docker:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "docker:down": "docker compose -f docker-compose.test.yml down -v",
    "test:docker": "npm run docker:up && REDIS_URL=redis://localhost:56379 POSTGRES_URL=postgres://postgres:pw@localhost:55432/tetrac_test MYSQL_URL=mysql://root:pw@localhost:53306/tetrac_test jest ; npm run docker:down",
    "test:engines": "npm run docker:up && REDIS_URL=redis://localhost:56379 POSTGRES_URL=postgres://postgres:pw@localhost:55432/tetrac_test MYSQL_URL=mysql://root:pw@localhost:53306/tetrac_test jest storage-conformance sql-conformance ; npm run docker:down"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0"
  },
  "peerDependencies": {
    "@ledgerhq/hw-app-solana": "^7.10.4",
    "@ledgerhq/hw-transport": "^6.35.4",
    "@ledgerhq/hw-transport-webhid": "^6.35.4",
    "@ledgerhq/hw-transport-webusb": "^6.34.4",
    "@solana/web3.js": "^1.98.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/kv": "^3.0.0",
    "better-sqlite3": ">=9",
    "ioredis": "^6.0.0",
    "mysql2": "^3",
    "next": ">=14",
    "pg": "^8",
    "react": ">=18",
    "tweetnacl": "^1.0.3",
    "viem": "^2.55.0"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-app-solana": {
      "optional": true
    },
    "@ledgerhq/hw-transport": {
      "optional": true
    },
    "@ledgerhq/hw-transport-webhid": {
      "optional": true
    },
    "@ledgerhq/hw-transport-webusb": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "@vercel/kv": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ledgerhq/hw-app-solana": "7.10.7",
    "@ledgerhq/hw-transport": "^6.31.0",
    "@ledgerhq/hw-transport-webhid": "6.36.0",
    "@ledgerhq/hw-transport-webusb": "6.35.0",
    "@solana/web3.js": "^1.98.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@upstash/redis": "^1.34.0",
    "@vercel/kv": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "ioredis": "^6.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mysql2": "^3.22.6",
    "pg": "^8.22.0",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.2.0",
    "tsup": "^8.3.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "viem": "^2.55.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "authentication",
    "web3",
    "passkey",
    "webauthn",
    "solana",
    "evm",
    "wallet",
    "non-custodial",
    "sdk",
    "postgres",
    "postgresql",
    "supabase",
    "mysql",
    "sqlite",
    "redis",
    "session-store",
    "auth"
  ]
}
